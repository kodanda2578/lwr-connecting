# Laughs With Ramesh Connecting Environment Variables Configuration

# Server & Database Settings
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lwr_connecting
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Secret
JWT_SECRET=lwr_connecting_super_secret_jwt_signing_key_2026_production_grade

# AI Service Provider Key (OpenAI / Gemini / Anthropic)
AI_PROVIDER=GEMINI
GEMINI_API_KEY=

# Email Service Provider & Genuine SMTP Delivery
# To enable real Gmail SMTP delivery:
# 1. Set EMAIL_PROVIDER=SMTP
# 2. Set SMTP_HOST=smtp.gmail.com and SMTP_PORT=587
# 3. In your Google Account (myaccount.google.com -> Security):
#    - Turn ON 2-Step Verification
#    - Search "App Passwords" -> Generate an app password for "Laughs With Ramesh Connecting"
# 4. Set SMTP_USERNAME to your full Gmail address (e.g. user@gmail.com)
# 5. Set SMTP_PASSWORD to your 16-character Google App Password (without spaces)
# 6. Set EMAIL_FROM to the same Gmail address
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Ramesh Mentor Notification Email
MENTOR_NOTIFICATION_EMAIL=ramesh.mentor@lwrconnecting.com

# SMS Provider Configuration
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=
SMS_ENABLED=false

# App Base URL
APP_BASE_URL=http://localhost:5173
