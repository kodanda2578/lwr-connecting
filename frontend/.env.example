# ============================================================
# LWR CONNECTING — FRONTEND ENVIRONMENT CONFIGURATION (Vercel)
# ============================================================
# NOTE: All VITE_* variables are bundled and visible to browsers.
# DO NOT place private credentials, JWT secrets, SMTP passwords,
# or database credentials in this file.

# Backend API Base URL (Render Cloud Service)
# Local development: Leave unset or empty to use Vite local proxy (http://localhost:8080/api)
# Production (Render): https://your-backend-service.onrender.com
VITE_API_BASE_URL=https://your-backend-service.onrender.com

# Public Frontend Application URL (Vercel Cloud Deployment)
# Used for constructing student invitation links and shareable URLs
# Local development: Leave unset or empty to automatically use window.location.origin
# Production (Vercel): https://your-app-name.vercel.app
VITE_PUBLIC_APP_URL=https://your-app-name.vercel.app

